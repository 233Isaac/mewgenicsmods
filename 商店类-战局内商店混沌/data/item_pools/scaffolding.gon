//pools with odds (sort common to rare so luck works properly!)
chapter {
    common 1
    uncommon 1
    rare 1
    very_rare 1
}

chapter_common {
    common 1
    uncommon 1
}
chapter_rare {
    rare 1
    very_rare 1
}

treasure_easy {
    uncommon 1
    rare 1
}
treasure_hard {
    uncommon 1
    rare 1
    very_rare 1
}

shop_rare {
    rare 1
    very_rare 1
}
shop_common {
    consumables 1
    common 1
    uncommon 1
    rare 1
    very_rare 1
}

any_chapter { //this will be changed later once "chapter" becomes actual chapter-specific items, need this for an event
    common 1
    uncommon 1
    rare 1
    very_rare 1
}


//new pools
combat_reward_easy {
    common 1
    uncommon 1
    rare 1
}
combat_reward_hard {
    common 1
    uncommon 1
    rare 1
    very_rare 1
}
combat_reward_miniboss {
    common 1
    uncommon 1
    rare 1
    very_rare 1
}
combat_reward_boss {
    common 1
    uncommon 1
    rare 1
    very_rare 1
}

//tracy house shop pools
tracy_houseshop_common {
    basic_consumables 1
    consumables 1
    shop_common 1
}
tracy_houseshop_common_item {
    common 1
    uncommon 1
}
tracy_houseshop_rare {
    consumables 1
    shop_common 1
}
tracy_houseshop_item {
    common 1
    uncommon 1
    rare 1
    very_rare 1
}
tracy_houseshop_bonusrare {
    rare 1
    very_rare 1
}

//these empty pools get re-mapped per chapter
current_chapter_common {
}
current_chapter_uncommon {
}
current_chapter_rare {
}
current_chapter_very_rare {
}

chapter_specific_item {
    current_chapter_common 1
    current_chapter_uncommon 1
    current_chapter_rare 1
    current_chapter_very_rare 1
}

//when rolling specific rarities, auto means the weight is proportional to the size
common {
    general_common auto
    current_chapter_common auto
    current_chapter_common auto
    current_chapter_common auto
    current_chapter_common auto
    current_chapter_common auto
}
uncommon {
    general_uncommon auto
    current_chapter_uncommon auto
    current_chapter_uncommon auto
    current_chapter_uncommon auto
    current_chapter_uncommon auto
    current_chapter_uncommon auto
}
rare {
    general_rare auto
    current_chapter_rare auto
    current_chapter_rare auto
    current_chapter_rare auto
    current_chapter_rare auto
    current_chapter_rare auto
}
very_rare {
    general_very_rare auto
    current_chapter_very_rare auto
    current_chapter_very_rare auto
    current_chapter_very_rare auto
    current_chapter_very_rare auto
    current_chapter_very_rare auto
}
