0 { //default difficulty
	boss_health_multiplier 1.2
	bonus_itemroll_luck 0
	coins_multiplier 1
	food_multiplier 1
	wallet_size 999
	event_difficulty 1
	
	easy {
		elite_budget 0.25
		champ_budget 0.25

		elite_buffs 1
		rare_elite_buffs 1
	}
	hard {
		champ_budget 2.5
		champ_chance_mini .25 //chance for maggots, fleas, etc to become champs

		elite_buffs 2
		rare_elite_buffs 2
	}
}

1 { //+1 difficulty
	boss_health_multiplier 1.5
	boss_elite_buffs 2
	bonus_itemroll_luck 8
	coins_multiplier 1.25
	food_multiplier 1.25
	wallet_size 999
	event_difficulty 2
	
	easy {
		elite_budget 0.5
		champ_budget 1.5
		champ_chance_mini .25

		elite_buffs 2
		rare_elite_buffs 3
	}
	hard {
		elite_budget 1.5
		champ_budget 3
		elite_chance_mini .25 //chance for maggots, fleas, etc to become elites
		champ_chance_mini .25 //chance for maggots, fleas, etc to become champs
		
		elite_buffs 2
		rare_elite_buffs 3
	}
}

