4 { //+4 difficulty, only accessible if you limit break difficulty by setting it to max and then equipping the quest item that makes you play on +1 difficulty
	boss_health_multiplier 3
	boss_elite_buffs 7
	bonus_itemroll_luck 200
	coins_multiplier 5
	food_multiplier 5
	wallet_size 999
	event_difficulty 7
	
