		elite_budget 4.5
		champ_budget 1.5
		elite_chance_mini .5
		champ_chance_mini .5

		elite_buffs 8
		rare_elite_buffs 10
	}
	hard {
		elite_budget 7.5
		champ_budget 1.5
		elite_chance_mini .5 //chance for maggots, fleas, etc to become elites
		champ_chance_mini .5 //chance for maggots, fleas, etc to become champs
		
