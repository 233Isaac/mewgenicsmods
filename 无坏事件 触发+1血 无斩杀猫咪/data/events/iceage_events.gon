FrozenHumanoid {
    intro {
        title "EVENT_FROZENHUMANOID_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame frozen_humanoid
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_FROZENHUMANOID_QUES"

        options {
            break_ice {
                label "EVENT_FROZENHUMANOID_BREAKICE_ANSW"

                good {
                    reward {
                        common {
                            prompt "EVENT_FROZENHUMANOID_REW1"
                            set_frame 2 
                            gain_familiar {
                                object CharmedCaveBaby
                                initial_health 10
                            }
                        }
                        rare {
                            prompt "EVENT_FROZENHUMANOID_REW2"
                            set_frame 3
                            learn_passive IcePaws
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            prompt "EVENT_FROZENHUMANOID_REW3"
                            set_frame 4
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_FROZENHUMANOID_REW4" 
                            set_frame 5
                            party_heal 1
                        }
                    }
                }
            }

            leave {
                label "EVENT_LEAVE_ANSW"
                stat none
                animation choice_leave

                good {
                    prompt "EVENT_FROZENHUMANOID_REW5"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}

MammothCarcass {
    intro {
        title "EVENT_MAMMOTHCARCASS_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame mammoth
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_MAMMOTHCARCASS_QUES"

        options {
            loot {
                label "EVENT_LOOT_ANSW"
                stat dex
                animation choice_dex_alt

                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_MAMMOTHCARCASS_REW1"
                            get_item_from_pool {
                                pool chapter_common
                                restrict consumables
                            }
                            gain_food [2 4]
                        }
                        rare {
                            prompt "EVENT_MAMMOTHCARCASS_REW2"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    set_frame 3
                    reward {
                        common {
                            prompt "EVENT_MAMMOTHCARCASS_REW3"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_MAMMOTHCARCASS_REW4"
                            party_heal 1
                        }
                    }
                }
            }

            examine {
                label "EVENT_EXAMINE_ANSW"
                stat int

                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_MAMMOTHCARCASS_REW5"
                            get_item_from_pool {
                                pool chapter_common
                                restrict consumables
                            }
                            gain_food [2 4]
                        }
                        rare {
                            prompt "EVENT_MAMMOTHCARCASS_REW6"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    set_frame 4
                    reward {
                        common {
                            prompt "EVENT_MAMMOTHCARCASS_REW7"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_MAMMOTHCARCASS_REW8"
                            party_heal 1
                        }
                    }
                }
            }

            ignore {
                label "EVENT_IGNORE_ANSW"
                stat none
                animation choice_leave
                
                good {
                    prompt "EVENT_MAMMOTHCARCASS_REW9"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}

MysteriousTent {
    intro {
        title "EVENT_MYSTERIOUSTENT_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame caveman_tent
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_MYSTERIOUSTENT_QUES"

        options {
            go_inside {
                label "EVENT_GOINSIDE_ANSW"
                stat str
                
                good {
                    set_frame 4
                    reward {
                        common {
                            prompt "EVENT_MYSTERIOUSTENT_REW1"
                            override_end_option_prompt "EVENT_MYSTERIOUSTENT_PROMPT"
                            party_heal 100%
                        }
                        rare {
                            prompt "EVENT_MYSTERIOUSTENT_REW2"
                            override_end_option_prompt "EVENT_MYSTERIOUSTENT_PROMPT"
                            shop_now Event_RareShop
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 2
                            prompt "EVENT_MYSTERIOUSTENT_REW3"
                            override_end_option_prompt "EVENT_MYSTERIOUSTENT_PROMPT"
                            party_heal 1
                        }
                        rare {
                            set_frame 3
                            prompt "EVENT_MYSTERIOUSTENT_REW4" 
                            party_heal 1
                        }
                    }
                }
            }
            
            ignore {
                label "EVENT_IGNORE_ANSW"
                stat none
                animation choice_leave
                
                good {
                    prompt "EVENT_MYSTERIOUSTENT_REW5"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}