CloggedPipes {
    intro {
        title "EVENT_CLOGGEDPIPES_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame clogged_pipes
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_CLOGGEDPIPES_QUES"

        options {
            examine {
                label "EVENT_EXAMINE_ANSW"
                stat int

                good {
                    reward {
                        common {
                            set_frame 2
                            prompt "EVENT_CLOGGEDPIPES_REW1"
                            self_status_next_fight{
                                AbilityOnBattleStart Flush
                            }
                        }
                        rare {
                            set_frame 3
                            prompt "EVENT_CLOGGEDPIPES_REW2"
                            get_item_from_pool chapter_rare
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 4
                            prompt "EVENT_CLOGGEDPIPES_REW3"
                            party_heal 1
                        }
                        rare {
                            set_frame 4
                            prompt "EVENT_CLOGGEDPIPES_REW4" 
                            party_heal 1
                        }
                    }
                }
            }
            clear {
                label "EVENT_CLEAR_ANSW"
                stat str

                good {
                    reward {
                        common {
                            set_frame 2
                            prompt "EVENT_CLOGGEDPIPES_REW5"
                            get_item_from_pool sewer_junk
                            get_item_from_pool sewer_junk
                            get_item_from_pool sewer_junk
                        }
                        rare {
                            set_frame 3
                            prompt "EVENT_CLOGGEDPIPES_REW6"
                            get_item_from_pool chapter_rare
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 4
                            prompt "EVENT_CLOGGEDPIPES_REW7"
                            party_heal 1
                        }
                        rare {
                            set_frame 4
                            prompt "EVENT_CLOGGEDPIPES_REW8" 
                            party_heal 1
                        }
                    }
                }
            }

            leave {
                label "EVENT_LEAVE_ANSW"
                stat none
                animation choice_leave

                good {
                    prompt "EVENT_CLOGGEDPIPES_REW9"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}

MutantCrocodile {
    intro {
        title "EVENT_MUTANTCROCODILE_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame mutant_croc
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_MUTANTCROCODILE_QUES"

        options {
            attack {
                label "EVENT_ATTACK_ANSW"
                stat str

                good {
                    reward {
                        common {
                            set_frame 2
                            prompt "EVENT_MUTANTCROCODILE_REW1"
                            gain_food [2 4]
                        }
                        rare {
                            set_frame 3
                            prompt "EVENT_MUTANTCROCODILE_REW2"
                            gain_food [2 4]
                            permanent_stats {
                                str 1
                            }
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 4
                            prompt "EVENT_MUTANTCROCODILE_REW3"
                            party_heal 1
                        }
                        rare {
                            set_frame 5
                            prompt "EVENT_MUTANTCROCODILE_REW4" 
                            party_heal 1
                        }
                    }
                }
            }
            distract {
                label "EVENT_DISTRACT_ANSW"
                stat int

                good {
                    reward {
                        common {
                            set_frame 4
                            prompt "EVENT_MUTANTCROCODILE_REW5"
                            //nothing
                        }
                        rare {
                            set_frame 2
                            prompt "EVENT_MUTANTCROCODILE_REW6"
                            gain_food [2 4]
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 5
                            prompt "EVENT_MUTANTCROCODILE_REW7"
                            party_heal 1
                        }
                        rare {
                            set_frame 4
                            prompt "EVENT_MUTANTCROCODILE_REW8" 
                            party_heal 1
                        }
                    }
                }
            }
        }
    }
}

TrashIsland {
    intro {
        title "EVENT_TRASHISLAND_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame trash_island
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_TRASHISLAND_QUES"

        options {
            swim {
                label "EVENT_SWIM_ANSW"
                stat con

                good {
                    reward {
                        common {
                            set_frame 2
                            prompt "EVENT_TRASHISLAND_REW1"
                            get_item_from_pool sewer_junk
                            get_item_from_pool sewer_junk
                            get_item_from_pool sewer_junk
                        }
                        rare {
                            set_frame 3
                            prompt "EVENT_TRASHISLAND_REW2"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 4
                            prompt "EVENT_TRASHISLAND_REW3"
                            party_heal 1
                        }
                        rare {
                            set_frame 5
                            prompt "EVENT_TRASHISLAND_REW4" 
                            party_heal 1
                        }
                    }
                }
            }

            jump {
                label "EVENT_JUMP_ANSW"
                stat dex
                animation choice_dex_alt

                good {
                    reward {
                        common {
                            set_frame 2
                            prompt "EVENT_TRASHISLAND_REW5"
                            get_item_from_pool sewer_junk
                            get_item_from_pool sewer_junk
                            get_item_from_pool sewer_junk
                        }
                        rare {
                            set_frame 3
                            prompt "EVENT_TRASHISLAND_REW6"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 6
                            prompt "EVENT_TRASHISLAND_REW7"
                            party_heal 1
                        }
                        rare {
                            set_frame 7
                            prompt "EVENT_TRASHISLAND_REW8" 
                            party_heal 1
                        }
                    }
                }
            }

            leave {
                label "EVENT_LEAVE_ANSW"
                stat none
                animation choice_leave

                good {
                    prompt "EVENT_TRASHISLAND_REW9"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}

GiantSleepingShark {
    intro {
        title "EVENT_GIANTSLEEPINGSHARK_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame sleeping_shark
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_GIANTSLEEPINGSHARK_QUES"

        options {
            sneak_by {
                label "EVENT_SNEAKBY_ANSW"
                stat dex

                good {
                    reward {
                        common {
                            set_frame 2
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW1"
                            //nothing
                        }
                        rare {
                            set_frame 3
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW2"
                            get_item_from_pool sewer_junk
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 4
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW3"
                            party_heal 1
                        }
                        rare {
                            set_frame 4
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW4" 
                            party_heal 1
                        }
                    }
                }
            }

            steal_gold_tooth {
                label "EVENT_STEALGOLDTOOTH_ANSW"
                stat lck

                good {
                    reward {
                        common {
                            set_frame 2
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW5"
                            gain_coins [10 30]
                        }
                        rare {
                            set_frame 3
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW6"
                            gain_coins [25 50]
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 4
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW7"
                            party_heal 1
                        }
                        rare {
                            set_frame 4
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW8" 
                            party_heal 1
                        }
                    }
                }
            }

            kiss {
                label "EVENT_KISS_ANSW"
                stat cha

                good {
                    set_frame 5 
                    reward {
                        common {
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW9"
                            //nothing
                        }
                        rare {
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW10"
                            gain_familiar CharmedDaddyShark
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 5
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW11"
                            party_heal 1
                        }
                        rare {
                            set_frame 4
                            prompt "EVENT_GIANTSLEEPINGSHARK_REW12" 
                            party_heal 1
                        }
                    }
                }
            }
        }
    }
}