                        }
                        rare {
                            prompt "EVENT_OLDCAR_REW10"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    set_frame 4
                    reward {
                        common {
                            prompt "EVENT_OLDCAR_REW11"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_OLDCAR_REW12"
                            party_heal 1
                        }
                    }
                }
            }
        }
    }
}

StartDigging {
    requirements {
        not_has_token WorldEventLegacyToken_StartDigging_Complete
    }

    intro {
        title "EVENT_STARTDIGGING_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame junk_pile
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_STARTDIGGING_QUES"

        options {
            dig {
                label "EVENT_STARTDIGGING_ANSW"
                stat str

                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_STARTDIGGING_REW1"
                            increment_legacy_counter WorldEventLegacyToken_StartDigging
                        }
                        rare {
                            prompt "EVENT_STARTDIGGING_REW2"
                            increment_legacy_counter WorldEventLegacyToken_StartDigging
                            increment_legacy_counter WorldEventLegacyToken_StartDigging
                        }
                    }

                    conditional_reward {
                        requirements {
                            counter_minimum [WorldEventLegacyToken_StartDigging 5]
                        }
                        reward {
                            set_legacy_token WorldEventLegacyToken_StartDigging_Complete
                        }
                    }
                }
                bad {
                    set_frame 4
                    reward {
                        common {
                            prompt "EVENT_STARTDIGGING_REW3"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_STARTDIGGING_REW4"
                            party_heal 1
                        }
                    }
                }
            }

            dig_dex {
                label "EVENT_STARTDIGGING_ANSW"
                stat dex
                animation choice_dex_alt

                copy_results dig
            }

            loot {
                label "EVENT_LOOT_ANSW"
                stat dex
                animation choice_dex_alt

                requirements {
                    has_token WorldEventLegacyToken_StartDigging_Complete
                }

                good {
                    set_frame 3
                    reward {
                        common {
                            prompt "EVENT_STARTDIGGING_REW5"
                            shop_now TreasureEasy
                        }
                        rare {
                            prompt "EVENT_STARTDIGGING_REW6"
                            shop_now TreasureHard
                        }
                    }
                }
                bad {
                    set_frame 5
                    reward {
                        common {
                            prompt "EVENT_STARTDIGGING_REW7"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_STARTDIGGING_REW8" 
                            party_heal 1
                        }
                    }
                }
            }
            
            leave {
                label "EVENT_LEAVE_ANSW"
                stat none
                animation choice_leave
                
                good {
                    prompt "EVENT_STARTDIGGING_REW9"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}