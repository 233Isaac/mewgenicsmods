BallOfCancer {
    intro {
        title "EVENT_BALLOFCANCER_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame ball_of_cancer
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_BALLOFCANCER_QUES"

        options {
            eat {
                label "EVENT_EAT_ANSW"
                stat con

                good {
                    set_frame 4
                    reward {
                        common {
                            prompt "EVENT_BALLOFCANCER_REW1"
                            heal 1
                        }
                        rare {
                            prompt "EVENT_BALLOFCANCER_REW2"
                            random_mutation 3
                        }
                    }
                }
                bad {
                    set_frame 5
                    reward {
                        common {
                            prompt "EVENT_BALLOFCANCER_REW3"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_BALLOFCANCER_REW4" 
                            party_heal 1
                        }
                    }
                }
            }
            
            kiss {
                label "EVENT_KISS_ANSW"
                stat cha

                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_BALLOFCANCER_REW5"
                            gain_familiar CharmedCancerBlob
                        }
                        rare {
                            prompt "EVENT_BALLOFCANCER_REW6"
                            gain_familiar CharmedCancerBlob
                            random_mutation 2
                        }
                    }
                }
                bad {
                    set_frame 5
                    reward {
                        common {
                            prompt "EVENT_BALLOFCANCER_REW7"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_BALLOFCANCER_REW8" 
                            party_heal 1
                        }
                    }
                }
            }

            ignore {
                label "EVENT_IGNORE_ANSW"
                stat none
                animation choice_leave

                good {
                    prompt "EVENT_BALLOFCANCER_REW9"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}

DemonAltar {
    intro {
        title "EVENT_DEMONALTAR_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame satan_altar
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_DEMONALTAR_QUES"

        options {
            pray {
                label "EVENT_PRAY_ANSW"
                stat cha

                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_DEMONALTAR_REW1"
                            get_item_from_pool {
                                pool chapter_common
                                restrict [weapon, trinket, armor]
                            }
                        }
                        rare {
                            prompt "EVENT_DEMONALTAR_REW2"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    set_frame 3
                    reward {
                        common {
                            prompt "EVENT_DEMONALTAR_REW3"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_DEMONALTAR_REW4" 
                            party_heal 1
                        }
                    }
                }
            }
            
            loot {
                label "EVENT_LOOT_ANSW"
                stat dex
                animation choice_dex_alt

                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_DEMONALTAR_REW5"
                            get_item_from_pool {
                                pool chapter_common
                                restrict [weapon, trinket, armor]
                            }
                        }
                        rare {
                            prompt "EVENT_DEMONALTAR_REW6"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    set_frame 3
                    reward {
                        common {
                            prompt "EVENT_DEMONALTAR_REW7"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_DEMONALTAR_REW8" 
                            party_heal 1
                        }
                    }
                }
            }

            ignore {
                label "EVENT_IGNORE_ANSW"
                stat none
                animation choice_leave

                good {
                    prompt "EVENT_DEMONALTAR_REW9"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}

CrackInTheEarth {
    intro {
        title "EVENT_CRACKINTHEEARTH_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame crack_in_earth
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_CRACKINTHEEARTH_QUES"

        options {
            dive {
                label "EVENT_DIVE_ANSW"
                stat lck

                good {
                    set_frame 3
                    reward {
                        common {
                            prompt "EVENT_CRACKINTHEEARTH_REW1"
                            get_item_from_pool {
                                pool chapter_common
                                restrict [weapon, trinket, armor]
                            }
                        }
                        rare {
                            prompt "EVENT_CRACKINTHEEARTH_REW2"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    set_frame 4
                    reward {
                        common {
                            prompt "EVENT_CRACKINTHEEARTH_REW3"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_CRACKINTHEEARTH_REW4" 
                            party_heal 1
                        }
                    }
                }
            }
            
            scream {
                label "EVENT_SCREAM_ANSW"
                stat str
                
                good {
                    set_frame 5
                    reward {
                        common {
                            prompt "EVENT_CRACKINTHEEARTH_REW5"
                            next_event_bonus 1
                            random_pool [
                                {
                                    event_now_same_cat DemonicIdol
                                }
                                {
                                    event_now_same_cat JaggedPathway
                                }
                                {
                                    event_now_same_cat MysteriousStranger
                                }
                            ]
                        }
                        rare {
                            prompt "EVENT_CRACKINTHEEARTH_REW6"
                            next_event_bonus 2
                            random_pool [
                                {
                                    event_now_same_cat DemonicIdol
                                }
                                {
                                    event_now_same_cat JaggedPathway
                                }
                                {
                                    event_now_same_cat MysteriousStranger
                                }
                            ]
                        }
                    }
                }
                bad {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_CRACKINTHEEARTH_REW7"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_CRACKINTHEEARTH_REW8" 
                            party_heal 1
                        }
                    }
                }
            }
            
            ignore {
                label "EVENT_IGNORE_ANSW"
                stat none
                animation choice_leave
                
                good {
                    prompt "EVENT_CRACKINTHEEARTH_REW9"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}