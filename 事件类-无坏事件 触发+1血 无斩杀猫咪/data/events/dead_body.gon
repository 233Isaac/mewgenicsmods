                            party_heal 1
                        }
                    }
                }
            }
            feed {
                label "EVENT_OLDFRIEND_ANSW_FEED"
                stat int
                
                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_OLDFRIEND_REW5"
                            gain_food -1
                            get_item_from_pool {
                                pool chapter_common
                                restrict [weapon, trinket, armor]
