DyingFetus {
    intro {
        title "EVENT_DYINGFETUS_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame dying_fetus
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_DYINGFETUS_QUES"

        options {
            comfort {
                label "EVENT_COMFORT_ANSW"
                stat cha

                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_DYINGFETUS_REW1"
                            gain_familiar CharmedFetus
                        }
                        rare {
                            prompt "EVENT_DYINGFETUS_REW2"
                            permanent_stats {
                                lck 1
                            }
                        }
                    }
                }
                bad {
                    set_frame 4
                    reward {
                        common {
                            prompt "EVENT_DYINGFETUS_REW3"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_DYINGFETUS_REW4"
                            party_heal 1
                        }
                    }
                }
            }
            
            patch_up {
                label "EVENT_PATCHUP_ANSW"
                stat int

                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_DYINGFETUS_REW5"
                            gain_familiar CharmedFetus                            
                        }
                        rare {
                            prompt "EVENT_DYINGFETUS_REW6"
                            gain_familiar CharmedFetus2
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            set_frame 5
                            prompt "EVENT_DYINGFETUS_REW7"
                            party_heal 1
                        }
                        rare {
                            set_frame 5
                            prompt "EVENT_DYINGFETUS_REW8"
                            party_heal 1
                        }
                    }
                }
            }
            attack {
                label "EVENT_ATTACK_ANSW"
                stat str
                
                good {
                    set_frame 3
                    reward {
                        common {
                            prompt "EVENT_DYINGFETUS_REW9"
                            spawn_unit_next_fight {
                                object DeadFetus
                                count 2
                                spawn_side cats
                            }
                        }
                        rare {
                            prompt "EVENT_DYINGFETUS_REW10"
                            get_parasite_from_pool flesh_armor
                        }
                    }
                }
                bad {
                    set_frame 6
                    reward {
                        common {
                            prompt "EVENT_DYINGFETUS_REW11"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_DYINGFETUS_REW12"
                            party_heal 1
                        }
                    }
                }
            }
        }
    }
}

CryingBoy {
    intro {
        title "EVENT_CRYINGBOY_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame cryingboy
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_CRYINGBOY_QUES"

        options {
            comfort {
                label "EVENT_COMFORT_ANSW"
                stat cha
                
                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_CRYINGBOY_REW1"
                            play_animation [resultLeave 0]
                        }
                        rare {
                            prompt "EVENT_CRYINGBOY_REW2"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    set_frame 3
                    reward {
                        common {
                            prompt "EVENT_CRYINGBOY_REW3"
                            party_heal 1
