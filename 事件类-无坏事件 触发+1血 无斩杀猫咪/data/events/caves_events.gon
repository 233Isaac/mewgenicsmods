SludgeBath {
    intro {
        title "EVENT_SLUDGEBATH_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame sludgebath
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_SLUDGEBATH_QUES"

        options {
            fish_out {
                label "EVENT_FISHOUT_ANSW"
                stat dex
                animation choice_dex_alt

                good {
                    set_frame 2
                    reward {
                        common {
                            prompt "EVENT_SLUDGEBATH_REW1"
                            get_item_from_pool {
                                pool chapter_common
                                restrict consumables
                            }
                        }
                        rare {
                            prompt "EVENT_SLUDGEBATH_REW2"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    set_frame 3
                    reward {
                        common {
                            prompt "EVENT_SLUDGEBATH_REW3"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_SLUDGEBATH_REW4"
                            party_heal 1
                        }
                    }
                }
            }

            drink {
                label "EVENT_DRINK_ANSW"
                stat con
                
                good {
                    set_frame 4
                    reward {
                        common {
                            prompt "EVENT_SLUDGEBATH_REW5"
                            full_heal 1
                        }
                        rare {
                            prompt "EVENT_SLUDGEBATH_REW6"
                            permanent_stats {
                                hp 2
                            }
                        }
                    }
                }
                bad {
                    set_frame 5
                    reward {
                        common {
                            prompt "EVENT_SLUDGEBATH_REW7"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_SLUDGEBATH_REW8"
                            party_heal 1
                        }
                    }
                }
            }

            ignore {
                label "EVENT_IGNORE_ANSW"
                stat none
                animation choice_leave
                
                good {
                    prompt "EVENT_SLUDGEBATH_REW9"
                    play_animation [resultLeave 0]
                }
            }
        }
    }
}

TheMeatGrinder {
    requirements {
        not_has_token WorldEventLegacyToken_NekroAmulet
    }
    
    intro {
        title "EVENT_MEATGRINDER_NAME"
        cat_choice random
        subject_clip EventSubject
        subject_frame flesh_device
        event_clip NonWheelEvent
    }

    main {
        prompt "EVENT_MEATGRINDER_QUES"

        options {
            sacrifice {
                label "EVENT_MEATGRINDER_ANSW_SACRIFICE"
                stat con

                good {
                    reward {
                        common {
                            prompt "EVENT_MEATGRINDER_REW1"
                            self_damage 2
                            set_frame 2
                            random_pool [
                                {
                                    get_item_from_pool {
                                        pool chapter_rare
                                        restrict [weapon, trinket, armor]
                                    }
                                }
                                {
                                    permanent_stats {
                                        lck 1
                                    }
                                }
                                {
                                    gain_coins [25 50]
                                }
                                {
                                    get_item_from_pool {
                                        pool chapter_common
                                        restrict consumables
                                    }
                                    get_item_from_pool {
                                        pool chapter_common
                                        restrict consumables
                                    }
                                    get_item_from_pool {
                                        pool chapter_common
                                        restrict consumables
                                    }
                                }
                            ]
                        }
                        rare {
                            prompt "EVENT_MEATGRINDER_REW2"
                            self_damage 2
                            set_frame 3
                            get_item NekromantikonAmulet
                            set_legacy_token WorldEventLegacyToken_NekroAmulet
                            trigger_adventure_unlock legacy_event_unlock_nekromantikonamulet
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            prompt "EVENT_MEATGRINDER_REW3"
                            set_frame 4
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_MEATGRINDER_REW4"
                            set_frame 4
                            party_heal 1
                        }
                    }
                }
            }
        }
    }
}