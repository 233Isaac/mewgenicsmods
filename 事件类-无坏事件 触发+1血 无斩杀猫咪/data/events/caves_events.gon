                            play_animation [resultLeave 0]
                        }
                        rare {
                            prompt "EVENT_CRYINGBOY_REW6"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    set_frame 3
                    reward {
                        common {
                            prompt "EVENT_CRYINGBOY_REW7"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_CRYINGBOY_REW8"
                            party_heal 1
                        }
                    }
                }
            }

            ignore {
                label "EVENT_IGNORE_ANSW"
                stat none
                animation choice_leave
                
                good {
                    set_frame 4
                    reward {
                        common {
                            prompt "EVENT_CRYINGBOY_REW9"
                            play_animation [resultLeave 0]
                        }
                        rare {
                            prompt "EVENT_CRYINGBOY_REW10"
                            get_item_from_pool {
                                pool chapter_rare
                                restrict [weapon, trinket, armor]
                            }
                        }
                    }
                }
                bad {
                    reward {
                        common {
                            prompt "EVENT_CRYINGBOY_REW9"
                            party_heal 1
                        }
                        rare {
                            prompt "EVENT_CRYINGBOY_REW10"
                            party_heal 1
                        }
                    }
                }
            }
        }
    }
}

